# Copy this file to .env and fill in your own values. Never commit .env.
# Port the app listens on
PORT=3000
# Secret used to sign login cookies (use any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# Anthropic API key (backend only, never exposed to the browser)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Claude model used for transcript conversion
ANTHROPIC_MODEL=claude-sonnet-5-5
# SQLite database file (created automatically)
DB_PATH=./data/novaworks.db
# Set to true only when serving over HTTPS (live deployment)
COOKIE_SECURE=false
